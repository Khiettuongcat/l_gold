#loket gold testing 


[SCRIPT]

revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Khiettuongcat/l_gold/refs/heads/main/log.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Khiettuongcat/l_gold/refs/heads/main/header.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com