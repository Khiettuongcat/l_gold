[Name]
RevenueCat Custom Config

[Description]
Rewrite RevenueCat API Response to add custom Gold entitlement.

[MITM]
hostname = api.revenuecat.com

[Script]
# Bắt tất cả endpoint subscribers
revenuecat_mod = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/subscribers\/[^/]+, script-path=https://raw.githubusercontent.com/Khiettuongcat/l_gold/refs/heads/main/module/unllock.js, requires-body=true, max-size=-1, timeout=30